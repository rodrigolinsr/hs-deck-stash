# Copy this file to .env for Docker Compose. Never commit the real .env file.
# Generate a long random value, e.g. `openssl rand -hex 32`.
SESSION_SECRET=replace-with-a-long-random-secret

# Values below are suitable for the local Docker stack.
MONGO_URL=mongodb://mongo:27017
DB_NAME=deck_stash
CORS_ORIGINS=http://localhost:3000

# Resend transactional email. Use a sender address on a verified Resend domain.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=HSDeckStash <hello@your-domain.example>
APP_BASE_URL=http://localhost:3000
# Keep disabled locally and in automated tests. Enable only in the deployed app.
EMAIL_DELIVERY_ENABLED=false
